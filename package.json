{
  "name": "nkd-crm",
  "version": "2.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "postinstall": "npm --prefix backend install --omit=dev --no-audit --no-fund",
    "setup:local": "npm --prefix backend run setup:local",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm install --prefix backend --omit=dev --no-audit --no-fund && npm install --prefix frontend --include=dev --no-audit --no-fund && npm --prefix frontend run build && node backend/scripts/sync-frontend.js",
    "build:frontend": "npm --prefix frontend run build && node backend/scripts/sync-frontend.js",
    "lint": "npm --prefix frontend run lint"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.3.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
