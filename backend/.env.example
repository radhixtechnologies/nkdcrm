PORT=5000
FRONTEND_URL=https://your-frontend.vercel.app

# Option A: Full Connection String (Render / Supabase / Neon provides this)
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Option B: Individual variables (for local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=NKD_CRM
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SSL=false

# Default Super Admin credentials
SUPER_ADMIN_EMAIL=admin@nkdcrm.com
SUPER_ADMIN_PASSWORD=Admin@123

# JWT configuration
JWT_SECRET=generate_a_secure_random_string_here
JWT_EXPIRES_IN=1d

# Optional AI API Key (Google Gemini is 100% free at https://aistudio.google.com/app/apikey)
# If left blank, the CRM automatically uses its built-in Indian statutory & HR AI engine with zero API cost!
GEMINI_API_KEY=
